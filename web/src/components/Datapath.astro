---
/* Datapath of mips_pipeline (rtl/mips_pipeline.v), drawn by hand as inline SVG so it follows
   the light/dark theme. Solid lines = data, dashed = control, the four bars = pipeline registers.
   Branches and jumps are resolved in ID (one delay slot), the register file is bypassed from WB,
   there is no forwarding: the hazard unit stalls instead. */
import FullscreenButton from './FullscreenButton.astro';
---

<figure class="diagram">
	<svg viewBox="0 0 1280 650" role="img" aria-labelledby="dp-title dp-desc">
		<title id="dp-title">Datapath of our 5-stage pipelined MIPS</title>
		<desc id="dp-desc">
			IF fetches 4 bytes from the instruction memory. ID decodes, reads the register file, extends the
			immediate and resolves branches and jumps. EX runs the ALU. MEM goes to the memory bus. WB writes
			the register file. Pipeline registers IF/ID, ID/EX, EX/MEM and MEM/WB sit between the stages.
		</desc>
		<defs>
			<marker id="dp-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="arrow"></path>
			</marker>
			<marker id="dp-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="arrow-ctl"></path>
			</marker>
		</defs>

		<!-- Stage names -->
		<text class="th" x="125" y="24" text-anchor="middle">IF · fetch</text>
		<text class="th" x="435" y="24" text-anchor="middle">ID · decode</text>
		<text class="th" x="740" y="24" text-anchor="middle">EX · execute</text>
		<text class="th" x="955" y="24" text-anchor="middle">MEM · memory</text>
		<text class="th" x="1175" y="24" text-anchor="middle">WB · write back</text>

		<!-- Pipeline registers -->
		<rect class="preg" x="240" y="40" width="18" height="545"></rect>
		<rect class="preg" x="610" y="40" width="18" height="545"></rect>
		<rect class="preg" x="840" y="40" width="18" height="545"></rect>
		<rect class="preg" x="1070" y="40" width="18" height="545"></rect>
		<text class="ts" x="249" y="600" text-anchor="middle">IF/ID</text>
		<text class="ts" x="619" y="600" text-anchor="middle">ID/EX</text>
		<text class="ts" x="849" y="600" text-anchor="middle">EX/MEM</text>
		<text class="ts" x="1079" y="600" text-anchor="middle">MEM/WB</text>

		<!-- ===== IF ===== -->
		<polygon class="box" points="30,270 56,282 56,348 30,360"></polygon>
		<text class="ts" x="43" y="262" text-anchor="middle">next PC</text>
		<rect class="box" x="78" y="290" width="52" height="40" rx="4"></rect>
		<text class="tb" x="104" y="315" text-anchor="middle">PC</text>
		<path class="wire" d="M56 310 H78" marker-end="url(#dp-a)"></path>

		<rect class="box" x="150" y="165" width="60" height="40" rx="6"></rect>
		<text class="tb" x="180" y="190" text-anchor="middle">+ 4</text>
		<path class="wire" d="M140 310 V185 H150" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M210 185 H222 V140 H18 V290 H30" marker-end="url(#dp-a)"></path>
		<text class="ts" x="60" y="133">PC + 4</text>

		<rect class="box" x="150" y="240" width="82" height="190" rx="4"></rect>
		<text class="t" x="191" y="258" text-anchor="middle">Instruction</text>
		<text class="t" x="191" y="273" text-anchor="middle">memory</text>
		<rect class="inner" x="156" y="288" width="70" height="22"></rect>
		<text class="ts" x="191" y="303" text-anchor="middle">b0 [31:24]</text>
		<rect class="inner" x="156" y="314" width="70" height="22"></rect>
		<text class="ts" x="191" y="329" text-anchor="middle">b1 [23:16]</text>
		<rect class="inner" x="156" y="340" width="70" height="22"></rect>
		<text class="ts" x="191" y="355" text-anchor="middle">b2 [15:8]</text>
		<rect class="inner" x="156" y="366" width="70" height="22"></rect>
		<text class="ts" x="191" y="381" text-anchor="middle">b3 [7:0]</text>
		<text class="ts" x="191" y="405" text-anchor="middle">4 byte banks</text>
		<text class="ts" x="191" y="420" text-anchor="middle">big-endian</text>
		<path class="wire" d="M130 310 H150" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="140" cy="310" r="3"></circle>
		<path class="wire" d="M232 335 H240" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M140 310 V490 H240" marker-end="url(#dp-a)"></path>
		<text class="ts" x="200" y="484">PC</text>

		<!-- stall from the hazard unit: holds PC and IF/ID -->
		<path class="ctl" d="M575 140 V56 H104 V290" marker-end="url(#dp-c)"></path>
		<text class="ts" x="300" y="51">stall: hold PC and IF/ID, bubble into ID/EX</text>

		<!-- ===== ID ===== -->
		<path class="wire" d="M258 335 H300"></path>
		<path class="wire" d="M300 100 V420"></path>
		<circle class="dot" cx="300" cy="335" r="3"></circle>
		<text class="ts" x="262" y="328">instr</text>
		<path class="wire" d="M300 100 H320" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M300 265 H340" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M300 300 H340" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M300 420 H340" marker-end="url(#dp-a)"></path>

		<rect class="box" x="320" y="70" width="120" height="60" rx="6"></rect>
		<text class="tb" x="380" y="96" text-anchor="middle">Control unit</text>
		<text class="ts" x="380" y="114" text-anchor="middle">opcode + funct</text>
		<path class="ctl" d="M440 100 H610" marker-end="url(#dp-c)"></path>
		<text class="ts" x="446" y="93">control signals</text>

		<rect class="box" x="470" y="140" width="125" height="40" rx="6"></rect>
		<text class="t" x="532" y="165" text-anchor="middle">Hazard unit</text>
		<path class="ctl" d="M595 160 H610" marker-end="url(#dp-c)"></path>

		<rect class="box" x="340" y="240" width="120" height="130" rx="4"></rect>
		<text class="tb" x="400" y="295" text-anchor="middle">Register</text>
		<text class="tb" x="400" y="312" text-anchor="middle">file</text>
		<text class="ts" x="400" y="330" text-anchor="middle">32 × 32 bits</text>
		<text class="ts" x="346" y="269">rs</text>
		<text class="ts" x="346" y="304">rt</text>
		<text class="ts" x="420" y="254">write</text>
		<text class="ts" x="452" y="274" text-anchor="end">A</text>
		<text class="ts" x="452" y="334" text-anchor="end">B</text>
		<path class="wire" d="M460 270 H610" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M460 330 H610" marker-end="url(#dp-a)"></path>

		<rect class="box" x="490" y="196" width="70" height="34" rx="4"></rect>
		<text class="t" x="525" y="218" text-anchor="middle">A = B ?</text>
		<path class="wire" d="M505 270 V230" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="505" cy="270" r="3"></circle>
		<path class="wire" d="M545 330 V230" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="545" cy="330" r="3"></circle>
		<path class="ctl" d="M560 213 H600 V500 H590" marker-end="url(#dp-c)"></path>
		<text class="ts" x="566" y="207">taken</text>

		<rect class="box" x="340" y="400" width="100" height="40" rx="4"></rect>
		<text class="t" x="390" y="418" text-anchor="middle">Extend</text>
		<text class="ts" x="390" y="432" text-anchor="middle">sign / zero</text>
		<path class="wire" d="M440 420 H610" marker-end="url(#dp-a)"></path>
		<text class="ts" x="585" y="414" text-anchor="end">imm</text>

		<rect class="box" x="320" y="470" width="135" height="40" rx="4"></rect>
		<text class="ts" x="387" y="485" text-anchor="middle">branch target</text>
		<text class="t" x="387" y="502" text-anchor="middle">PC+4 + imm×4</text>
		<rect class="box" x="320" y="522" width="135" height="40" rx="4"></rect>
		<text class="ts" x="387" y="537" text-anchor="middle">jump target</text>
		<text class="ts" x="387" y="553" text-anchor="middle">{'{PC+4[31:28], index, 00}'}</text>
		<path class="wire" d="M470 420 V455 H400 V470" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="470" cy="420" r="3"></circle>
		<path class="wire" d="M258 490 H320" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M290 490 V542 H320" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="290" cy="490" r="3"></circle>
		<path class="wire" d="M455 490 H480" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M455 542 H480" marker-end="url(#dp-a)"></path>

		<rect class="box" x="480" y="480" width="110" height="90" rx="6"></rect>
		<text class="t" x="535" y="514" text-anchor="middle">Next-PC</text>
		<text class="t" x="535" y="530" text-anchor="middle">select</text>
		<text class="ts" x="535" y="552" text-anchor="middle">branch · j · jr</text>
		<path class="wire" d="M535 570 V628 H10 V340 H30" marker-end="url(#dp-a)"></path>
		<text class="ts" x="60" y="622">redirect: branch / jump target (the delay slot still runs)</text>

		<!-- ===== EX ===== -->
		<path class="ctl" d="M628 100 H840" marker-end="url(#dp-c)"></path>
		<text class="ts" x="632" y="93">ALU ctl, ALUSrc, Mem*, RegWrite</text>

		<polygon class="box" points="660,320 686,332 686,428 660,440"></polygon>
		<text class="ts" x="673" y="312" text-anchor="middle">ALUSrc</text>
		<path class="wire" d="M628 330 H660" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M628 420 H660" marker-end="url(#dp-a)"></path>

		<polygon class="box" points="720,240 800,280 800,360 720,400 720,335 735,320 720,305"></polygon>
		<text class="tb" x="768" y="325" text-anchor="middle">ALU</text>
		<path class="wire" d="M628 270 H720" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M686 380 H720" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M800 320 H840" marker-end="url(#dp-a)"></path>
		<text class="ts" x="760" y="420" text-anchor="middle">result, or address A + imm</text>

		<path class="wire" d="M645 330 V500 H840" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="645" cy="330" r="3"></circle>
		<text class="ts" x="700" y="494">store data (B)</text>

		<rect class="box" x="690" y="520" width="130" height="40" rx="4"></rect>
		<text class="t" x="755" y="538" text-anchor="middle">mult / div</text>
		<text class="ts" x="755" y="552" text-anchor="middle">HI, LO (for C / Doom)</text>

		<!-- ===== MEM ===== -->
		<path class="ctl" d="M858 100 H1070" marker-end="url(#dp-c)"></path>
		<text class="ts" x="862" y="93">MemRead, MemWrite, MemtoReg</text>

		<rect class="box" x="885" y="225" width="135" height="190" rx="4"></rect>
		<text class="tb" x="952" y="246" text-anchor="middle">Memory bus</text>
		<text class="ts" x="952" y="262" text-anchor="middle">life_system decoder</text>
		<text class="ts" x="895" y="290">0x1001… data</text>
		<text class="ts" x="895" y="306">0x1004… framebuffer</text>
		<text class="ts" x="895" y="340">0x7FFF… stack</text>
		<text class="ts" x="895" y="356">0xFFFF… MMIO</text>
		<text class="ts" x="895" y="372">0x2000… SDRAM</text>
		<text class="ts" x="895" y="400">else: halt (E on HEX)</text>
		<path class="wire" d="M858 320 H885" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M858 500 H952 V415" marker-end="url(#dp-a)"></path>

		<polygon class="box" points="1040,280 1062,292 1062,388 1040,400"></polygon>
		<text class="ts" x="1046" y="272" text-anchor="middle">MemtoReg</text>
		<path class="wire" d="M1020 300 H1040" marker-end="url(#dp-a)"></path>
		<path class="wire" d="M872 320 V450 H1030 V380 H1040" marker-end="url(#dp-a)"></path>
		<circle class="dot" cx="872" cy="320" r="3"></circle>
		<path class="wire" d="M1062 340 H1070" marker-end="url(#dp-a)"></path>

		<!-- ===== WB ===== -->
		<path class="ctl" d="M1088 100 H1160" marker-end="url(#dp-c)"></path>
		<text class="ts" x="1165" y="104">RegWrite</text>
		<path class="wire" d="M1088 340 H1240 V190 H420 V240" marker-end="url(#dp-a)"></path>
		<text class="ts" x="1095" y="333">value + destination</text>
		<text class="ts" x="660" y="184">WB → register file (bypassed to ID in the same cycle)</text>
	</svg>
	<figcaption class="diagram-legend">
		<span>data</span>
		<span class="lg-ctl">control</span>
		<span class="lg-preg">pipeline register</span>
		<FullscreenButton />
	</figcaption>
</figure>
